# ============================================================
#  Cringe Volume Player — шаблон переменных окружения
#  Скопируй в .env и заполни:  cp .env.example .env
#  .env в git НЕ попадает (см. .gitignore).
# ============================================================

# ===== ПЛАТЁЖНЫЙ СЛОЙ =====
# mock = безопасная имитация RollyPay, без реальных списаний.
PAYMENT_MODE=mock

ROLLYPAY_BASE_URL=https://rollypay.io
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=

# ===== БЭКЕНД =====
SERVER_PORT=8080

# Публичные адреса (за реверс-прокси, поддомен pay.vernovpn.com).
PUBLIC_BACKEND_URL=https://pay.vernovpn.com
PUBLIC_PAY_BASE_URL=https://pay.vernovpn.com
PAYMENT_CALLBACK_URL=https://pay.vernovpn.com/api/payments/webhook

# ===== SMTP (отправка «чека» об оплате на email) =====
# Порт 465 = SSL/implicit TLS (НЕ STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Cringe Volume Player
SMTP_USE_TLS=true
