# ============================================================
#  Cringe Volume Player — шаблон переменных окружения
#  Скопируйте в .env и заполните значения:  cp .env.example .env
# ============================================================

# ===== ПЛАТЁЖНЫЙ СЛОЙ =====
PAYMENT_MODE=mock
ROLLYPAY_BASE_URL=https://rollypay.io
ROLLYPAY_API_KEY=rpk_live_xxxxxxxxxxxxxxxx_REPLACE_ME
ROLLYPAY_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxx_REPLACE_ME

# ===== БЭКЕНД =====
SERVER_PORT=8080

# Публичные URL (за реверс-прокси)
PUBLIC_BACKEND_URL=http://localhost:8080
PUBLIC_PAY_BASE_URL=http://localhost:8080
PAYMENT_CALLBACK_URL=http://localhost:8080/api/payments/webhook
PUBLIC_WEB_URL=http://localhost:8080

# ===== МУЗЫКА =====
MUSIC_DIR=./music

# ===== SMTP (чеки по email) =====
# Порт 465 = SSL/implicit TLS (SMTP_USE_TLS=true)
# Порт 587 = STARTTLS (SMTP_USE_TLS=false)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Cringe Volume Player
SMTP_USE_TLS=true
