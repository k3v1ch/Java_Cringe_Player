<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="16"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cringe.player.payment.PaymentDialogController"
      style="-fx-background-color: #1a1a2e;">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="💳 Оплата изменения громкости"
           style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
        <font><Font size="18"/></font>
    </Label>

    <Separator/>

    <!-- Информация о платеже -->
    <VBox spacing="4" alignment="CENTER"
          style="-fx-background-color: #16213e; -fx-padding: 16; -fx-background-radius: 10;">
        <Label fx:id="amountLabel" text="Сумма: ..."
               style="-fx-text-fill: #e94560; -fx-font-weight: bold;">
            <font><Font size="20"/></font>
        </Label>
        <Label fx:id="descriptionLabel" text="Загрузка..."
               style="-fx-text-fill: #a0a0b0;">
            <font><Font size="12"/></font>
        </Label>
    </VBox>

    <!-- Спиннер и статус -->
    <ProgressIndicator fx:id="spinner" prefWidth="48" prefHeight="48"
                       style="-fx-progress-color: #e94560;"/>

    <Label fx:id="statusLabel" text="Создание платежа..."
           style="-fx-text-fill: #16c79a; -fx-font-weight: bold;"
           wrapText="true" alignment="CENTER">
        <font><Font size="14"/></font>
    </Label>

    <Label text="Страница оплаты открыта в браузере"
           style="-fx-text-fill: #a0a0b0;">
        <font><Font size="11"/></font>
    </Label>

    <!-- Кнопки -->
    <HBox alignment="CENTER" spacing="12">
        <Button fx:id="openBrowserButton" text="🌐 Открыть повторно"
                onAction="#onOpenBrowser" disable="true"
                style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button fx:id="cancelButton" text="Отмена"
                onAction="#onCancel"
                style="-fx-background-color: #333; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>
</VBox>
